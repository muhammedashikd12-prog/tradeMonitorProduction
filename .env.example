# --- Fyers API credentials (from https://myapi.fyers.in) ---
FYERS_APP_ID=YOUR_APP_ID
FYERS_SECRET_ID=YOUR_SECRET_ID
FYERS_REDIRECT_URI=http://127.0.0.1:8000/fyers/callback
FYERS_ACCESS_TOKEN=

# --- Capital & risk ---
TOTAL_CAPITAL=80000
MAX_RISK_PER_TRADE_PCT=1.0
MAX_DAILY_LOSS_PCT=1.5
DRAWDOWN_STOP_PCT=15.0

# --- Strategy defaults (all overridable at runtime via /settings) ---
DEFAULT_WING_WIDTHS=100,150,200,250
PREFERRED_PREMIUM_MIN=8
PREFERRED_PREMIUM_MAX=10
IV_LOW_MAX=13.0
IV_PREFERRED_MAX=18.0
IV_HIGH_MAX=22.0

# NIFTY lot size — VERIFY this is current before trading live (NSE changes
# it periodically). Check https://public.fyers.in/sym_details/NSE_FO.csv
# or nseindia.com. The app will also try to auto-confirm this at boot.
NIFTY_LOT_SIZE=75

# --- Operating mode: analysis | alert | execution ---
OPERATING_MODE=analysis
EXECUTION_MODE=off
