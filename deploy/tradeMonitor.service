[Unit]
Description=tradeMonitor FastAPI application
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/tradeMonitor
EnvironmentFile=/home/ubuntu/tradeMonitor/.env
ExecStart=/home/ubuntu/tradeMonitor/.venv/bin/python -m uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
